# Copie para .env (o "npm run dev" faz isso sozinho na primeira vez).

# Login do painel do gestor (/gestor)
GESTOR_USUARIO=gestor
GESTOR_SENHA=movecidade
SESSAO_SEGREDO=troque-por-um-texto-longo-e-aleatorio

# Simulação: quantas vezes mais rápido que o relógio. Os tempos mostrados ao usuário
# já são convertidos, então o ônibus chega ao ponto quando a contagem chega a "agora".
FATOR_TEMPO=2

# 0 = não consulta o OSRM (usa só o traçado salvo / linhas retas entre pontos)
OSRM_ATIVO=1

# 0 = desliga as quedas de sinal GPS simuladas
SIM_FALHA_GPS=1

# Opcional: endpoint de LLM para reescrever o resumo do turno (Hermes).
# Recebe POST {"frases": [...]} e deve devolver {"texto": "..."}. Vazio = template.
HERMES_LLM_URL=

# Opcional: token público do Mapbox (pk.*) para o mapa ao vivo. Vazio = Leaflet local.
MOVECIDADE_MAPBOX_TOKEN=
